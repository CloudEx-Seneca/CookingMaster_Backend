syntax = "v1"

info (
	title:  "Recipe API"
	desc:   "Api description for recipe"
	author: "gilfoylegpt"
	email:  "fuhaojie930@gmail.com"
)

type RecipeInfo {
	name        string   `json:"name"`
	description string   `json:"description"`
//	ingredients []string `json:"ingredients"`
//	quantities  []string `json:"quantities"`
}

type (
	RecipeInsertoOrUpdateReq {
		Recipe RecipeInfo `json:"recipe"`
	}
	RecipeInsertOrUpdateResp  {}
)

type (
	RecipeDeleteReq {
		name string `json:"name"`
	}
	RecipeDeleteResp  {}
)

type (
	RecipeDetailReq {
		name string `json:"name"`
	}
	RecipeDetailResp {
		Recipe RecipeInfo `json:"recipe"`
	}
)

type (
	RecipeListReq  {}
	RecipeListResp {
		RecipeList []RecipeInfo `json:"recipes"`
	}
)

@server (
	prefix: recipe/v1
	group:  recipe
	jwt:    JwtAuth
)
service recipe-api {
	@handler RecipeInsertOrUpdate
	post /recipe/insertorupdate (RecipeInsertoOrUpdateReq) returns (RecipeInsertOrUpdateResp)

	@handler RecipeDetail
	post /recipe/detail (RecipeDetailReq) returns (RecipeDetailResp)

	@handler RecipeDelete
	post /recipe/delete (RecipeDeleteReq) returns (RecipeDeleteResp)

	@handler RecipeList
	post /recipe/list (RecipeListReq) returns (RecipeListResp)
}

